#
# User service: galleon-customizerd starts with the graphical session and is restarted
# if it stops. Installed by `cmake --install` in lib/systemd/user/; enable it with
#   systemctl --user enable --now galleon-customizerd.service
# To run from the build tree instead, see tools/systemd/galleon-customizerd-dev.service.

[Unit]
Description=Galleon Customizer daemon (Corsair Galleon 100 SD Stream Deck module)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/galleon-customizerd
# The module may be unplugged or the player absent: galleon-customizerd waits for them by
# itself. A real failure (another galleon-customizerd running exits with 1) is retried slowly.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
