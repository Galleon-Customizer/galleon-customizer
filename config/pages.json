    "0": {
      "turn": {
        "type": "theme"
      },
      "press": {
        "type": "page",
        "page": "chup-phim-tat"
      }
    },
    "1": {
      "turn": {
        "type": "media",
        "command": "volume",
        "step": 3
      },
      "press": {
        "type": "media",
        "command": "mute"
      }
    }
